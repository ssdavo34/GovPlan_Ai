# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/govplan_ai
MONGODB_URL=mongodb://localhost:27017/govplan_ai
REDIS_URL=redis://localhost:6379/0

# API Keys
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# Application Settings
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=your-secret-key-here
API_HOST=0.0.0.0
API_PORT=8000

# Crawling Settings
CRAWLER_USER_AGENT=GovPlanAI/1.0
CRAWLER_DELAY_SECONDS=1
CRAWLER_MAX_RETRIES=3
CRAWLER_TIMEOUT=30

# AI Settings
AI_MODEL=claude-3-5-sonnet-20241022
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# Notification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@govplanai.com

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
SLACK_BOT_TOKEN=xoxb-xxx

# Scheduling
CRAWLER_SCHEDULE_HOUR=9
CRAWLER_SCHEDULE_MINUTE=0

# File Storage
UPLOAD_DIR=./uploads
DOCUMENT_DIR=./documents
MAX_UPLOAD_SIZE_MB=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# CORS (for frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
